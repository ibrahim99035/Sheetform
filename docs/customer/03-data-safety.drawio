        <mxCell id="pc4" value="A reliable service you can stand behind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8fbe9a;fontSize=14;verticalAlign=middle;" vertex="1" parent="boxC">
